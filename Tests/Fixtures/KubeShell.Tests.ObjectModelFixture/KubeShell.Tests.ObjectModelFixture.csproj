<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The fixture validates net8.0 libraries but may be executed by a machine that only
         has a newer .NET runtime (for example PowerShell 7.6 / .NET 10 development hosts).
         This is a test-host policy only; production projects remain net8.0. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Runtime/KubeShell.Runtime/KubeShell.Runtime.csproj" />
    <ProjectReference Include="../../../ObjectModel/KubeShell.ObjectModel/KubeShell.ObjectModel.csproj" />
    <ProjectReference Include="../../../Hosting/KubeShell.Hosting/KubeShell.Hosting.csproj" />
    <ProjectReference Include="../../../Backends/KubeShell.KubernetesClient/KubeShell.KubernetesClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../discovery-parity.json" Link="discovery-parity.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
