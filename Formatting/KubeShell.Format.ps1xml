<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>KubeShell.Pod.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Pod</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader>
          <TableColumnHeader><Label>NAME</Label></TableColumnHeader>
          <TableColumnHeader><Label>READY</Label></TableColumnHeader>
          <TableColumnHeader><Label>STATUS</Label></TableColumnHeader>
          <TableColumnHeader><Label>RESTARTS</Label></TableColumnHeader>
          <TableColumnHeader><Label>AGE</Label></TableColumnHeader>
          <TableColumnHeader><Label>NODE</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ready</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Phase</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Restarts</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>AgeText</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Deployment.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Deployment</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader>
          <TableColumnHeader><Label>READY</Label></TableColumnHeader><TableColumnHeader><Label>AVAILABLE</Label></TableColumnHeader>
          <TableColumnHeader><Label>UPDATED</Label></TableColumnHeader><TableColumnHeader><Label>AGE</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ready</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Available</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Updated</PropertyName></TableColumnItem><TableColumnItem><PropertyName>AgeText</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Service.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Service</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader>
          <TableColumnHeader><Label>TYPE</Label></TableColumnHeader><TableColumnHeader><Label>CLUSTER-IP</Label></TableColumnHeader>
          <TableColumnHeader><Label>EXTERNAL-IP</Label></TableColumnHeader><TableColumnHeader><Label>PORTS</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ServiceType</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ClusterIP</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ExternalIP</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Ports</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Node.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Node</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>READY</Label></TableColumnHeader>
          <TableColumnHeader><Label>ROLES</Label></TableColumnHeader><TableColumnHeader><Label>UNSCHEDULABLE</Label></TableColumnHeader><TableColumnHeader><Label>AGE</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Ready</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Roles</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Unschedulable</PropertyName></TableColumnItem><TableColumnItem><PropertyName>AgeText</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Secret.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Secret</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>TYPE</Label></TableColumnHeader><TableColumnHeader><Label>KEYS</Label></TableColumnHeader><TableColumnHeader><Label>AGE</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>SecretType</PropertyName></TableColumnItem><TableColumnItem><PropertyName>DataKeys</PropertyName></TableColumnItem><TableColumnItem><PropertyName>AgeText</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Context.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Context</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>CURRENT</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>CLUSTER</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>USER</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Current</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Cluster</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Diagnostic.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Diagnostic</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>SEVERITY</Label></TableColumnHeader><TableColumnHeader><Label>COMPONENT</Label></TableColumnHeader><TableColumnHeader><Label>CHECK</Label></TableColumnHeader><TableColumnHeader><Label>MESSAGE</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Component</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Check</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.PodMetrics.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.PodMetrics</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>CPU(m)</Label></TableColumnHeader><TableColumnHeader><Label>MEM(MiB)</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>CpuMillicores</PropertyName></TableColumnItem><TableColumnItem><PropertyName>MemoryMiB</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.NodeMetrics.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.NodeMetrics</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>CPU(m)</Label></TableColumnHeader><TableColumnHeader><Label>MEM(MiB)</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>CpuMillicores</PropertyName></TableColumnItem><TableColumnItem><PropertyName>MemoryMiB</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.NodeAllocation.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.NodeAllocation</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>PODS</Label></TableColumnHeader><TableColumnHeader><Label>CPU REQ%</Label></TableColumnHeader><TableColumnHeader><Label>CPU LIM%</Label></TableColumnHeader><TableColumnHeader><Label>MEM REQ%</Label></TableColumnHeader><TableColumnHeader><Label>MEM LIM%</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Pods</PropertyName></TableColumnItem><TableColumnItem><PropertyName>RequestCpuPercent</PropertyName></TableColumnItem><TableColumnItem><PropertyName>LimitCpuPercent</PropertyName></TableColumnItem><TableColumnItem><PropertyName>RequestMemoryPercent</PropertyName></TableColumnItem><TableColumnItem><PropertyName>LimitMemoryPercent</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.ResourceEvent.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.ResourceEvent</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>TYPE</Label></TableColumnHeader><TableColumnHeader><Label>KIND</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>TIME</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Timestamp</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Bookmark.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Bookmark</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>PROFILE</Label></TableColumnHeader><TableColumnHeader><Label>CONFIG SET</Label></TableColumnHeader><TableColumnHeader><Label>CONTEXT</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>RESOURCE</Label></TableColumnHeader><TableColumnHeader><Label>RESOURCE NAME</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ConfigSet</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Context</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Resource</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ResourceName</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.ConfigSet.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.ConfigSet</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>ACTIVE</Label></TableColumnHeader><TableColumnHeader><Label>PATHS</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Active</PropertyName></TableColumnItem><TableColumnItem><ScriptBlock>$_.Paths -join [IO.Path]::PathSeparator</ScriptBlock></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Profile.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Profile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>ACTIVE</Label></TableColumnHeader><TableColumnHeader><Label>CONFIG SET</Label></TableColumnHeader><TableColumnHeader><Label>CONTEXT</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Active</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ConfigSet</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Context</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.Session.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.Session</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>PROFILE</Label></TableColumnHeader><TableColumnHeader><Label>CONFIG SET</Label></TableColumnHeader><TableColumnHeader><Label>CONTEXT</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>SOURCE</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ConfigSet</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Context</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.SchemaField.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.SchemaField</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>RESOURCE</Label></TableColumnHeader><TableColumnHeader><Label>API VERSION</Label></TableColumnHeader><TableColumnHeader><Label>PATH</Label></TableColumnHeader><TableColumnHeader><Label>TYPE</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Resource</PropertyName></TableColumnItem><TableColumnItem><PropertyName>ApiVersion</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.ApiSession.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.ApiSession</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>SERVER</Label></TableColumnHeader><TableColumnHeader><Label>CONTEXT</Label></TableColumnHeader><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>SKIP TLS VERIFY</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Server</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Context</PropertyName></TableColumnItem><TableColumnItem><PropertyName>DefaultNamespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>SkipCertificateCheck</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.HelmRelease.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.HelmRelease</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders><TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader><TableColumnHeader><Label>NAME</Label></TableColumnHeader><TableColumnHeader><Label>REVISION</Label></TableColumnHeader><TableColumnHeader><Label>STATUS</Label></TableColumnHeader><TableColumnHeader><Label>CHART</Label></TableColumnHeader><TableColumnHeader><Label>APP VERSION</Label></TableColumnHeader></TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems><TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Revision</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Chart</PropertyName></TableColumnItem><TableColumnItem><PropertyName>AppVersion</PropertyName></TableColumnItem></TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>KubeShell.ChangeResult.Table</Name>
      <ViewSelectedBy><TypeName>KubeShell.ChangeResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>OPERATION</Label></TableColumnHeader>
          <TableColumnHeader><Label>RESOURCE</Label></TableColumnHeader>
          <TableColumnHeader><Label>NAMESPACE</Label></TableColumnHeader>
          <TableColumnHeader><Label>NAME</Label></TableColumnHeader>
          <TableColumnHeader><Label>DRY-RUN</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Operation</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Resource</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Namespace</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DryRun</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
